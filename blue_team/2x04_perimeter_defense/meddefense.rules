# 1. Med device to Internet (any TCP/UDP from 10.10.4.0/24 to outside $HOME_NET, except port 123 UDP)
alert ip 10.10.4.0/24 any -> !$HOME_NET any (msg:"MEDDEV to Internet Outbound Traffic"; ip.proto:tcp,udp; dport:!123; classtype:policy-violation; sid:9000001; rev:1;)

# 2. Unauthorized SMB from guest network (tcp/445 from 10.10.5.0/24 to $HOME_NET)
alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"Unauthorized SMB Access from Guest Network"; flow:established,to_server; classtype:attempted-recon; sid:9000002; rev:1;)

# 3. Large outbound from server (10.10.1.0/24 pushing >50MB TCP payload to external host in 300s)
alert tcp 10.10.1.0/24 any -> !$HOME_NET any (msg:"Large Outbound Data Transfer from Server VLAN"; flow:established,to_server; threshold: type threshold, track by_dst, count 50000000, seconds 300; classtype:policy-violation; sid:9000003; rev:1;)

# 4. DNS tunneling (DNS query where leftmost label exceeds 50 characters using pcre)
alert dns any any -> any any (msg:"DNS Tunneling Long Leftmost Label Detected"; dns.query; pcre:"/^[a-zA-Z0-9-]{51,}\./"; classtype:trojan-activity; sid:9000004; rev:1;)

# 5. Clinical workstation to unauthorized database (tcp/3306 from 10.10.2.0/24 not to billing database)
alert tcp 10.10.2.0/24 any -> !10.10.1.50 3306 (msg:"Clinical Workstation Access to Unauthorized MySQL Database"; flow:established,to_server; classtype:attempted-recon; sid:9000005; rev:1;)

# 6. Telnet cleartext to medical device (tcp/23 to 10.10.4.0/24 from any source)
alert tcp any any -> 10.10.4.0/24 23 (msg:"Cleartext Telnet Session to Medical Device VLAN"; flow:established,to_server; classtype:misc-activity; sid:9000006; rev:1;)
